# ============================================================
#  Logi-Track ZeroBaran - متغيرات البيئة
#  انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# ============================================================

# === معلومات المشروع ===
PROJECT_NAME="Logi-Track ZeroBaran"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="production"

# === Supabase - قاعدة البيانات ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# === Google Gemini API - العقل الذكي ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# === Groq API (بديل مجاني سريع) ===
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# === إعدادات النظام ===
POLL_INTERVAL_HOURS=1
TIMEZONE=Asia/Istanbul
DEFAULT_LANGUAGE=ar

# === شركات الشحن (اختياري - للمتابعة المباشرة) ===
# أضف مفاتيح API الخاصة بشركات الشحن إن توفرت
ARAMEX_API_KEY=
DHL_API_KEY=
FEDEX_API_KEY=
TURKEY_PTT_API_KEY=

# === منصات المتاجر ===
SHOPIFY_API_KEY=
SHOPIFY_SHOP_DOMAIN=
